// PetService VE — Modelo de datos
// Marketplace de servicios a domicilio para mascotas (Venezuela)

generator client {
  provider = "prisma-client-js"
  // "native" = desarrollo local; "rhel-openssl-3.0.x" = runtime de Vercel
  // (Amazon Linux). Requerido cuando el build se hace fuera de Vercel
  // (GitHub Actions con vercel build --prebuilt).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ────────────────────────────── Usuarios ──────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String?
  name         String
  role         String   @default("CLIENT") // CLIENT | PROVIDER | ADMIN
  passwordHash String   @default("") // scrypt: s2:<saltB64>:<hashB64> (vacío = solo OAuth)
  googleId     String?  @unique // login con Google (OAuth 2.0)
  avatarUrl    String?  // foto de perfil de Google u otra fuente
  // Un admin puede desactivar una cuenta: bloquea login y sesión sin borrar datos
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  provider       Provider?
  pets           Pet[]
  clientBookings Booking[] @relation("ClientBookings")
  passwordResets PasswordReset[]
  crmContacts    CrmContact[]
}

// ────────────────────────────── Prestadores ──────────────────────────────

model Provider {
  id           String @id @default(cuid())
  userId       String @unique
  user         User   @relation(fields: [userId], references: [id])
  businessName String
  bio          String
  // PENDING | VERIFIED | REJECTED | SUSPENDED
  status       String @default("PENDING")
  city         String
  zoneName     String // municipio / parroquia (ej: Chacao, El Cafetal)
  lat          Float
  lng          Float
  radiusKm     Float  @default(5)
  // {"1":[["08:00","12:00"],["14:00","18:00"]], ...} (1=Lunes … 7=Domingo)
  scheduleJson String @default("{}")
  ratingAvg    Float  @default(0)
  ratingCount  Int    @default(0)
  // badges separados por coma: VERIFICADO, TOP, EXPRESS, GATOS
  badges       String @default("")

  services Service[]
  bookings Booking[]
  reviews  Review[]
}

// ────────────────────────────── Servicios ──────────────────────────────

model Service {
  id          String @id @default(cuid())
  providerId  String
  provider    Provider @relation(fields: [providerId], references: [id])
  // GROOMING | DELIVERY | PET_SITTING | DOG_WALKING | TRAINING | PET_TAXI | SPA_MOVIL | VET
  category    String
  name        String
  description String
  durationMin Int
  priceUsd    Float
  // Tope opcional del rango de precio ("desde priceUsd hasta priceToUsd")
  priceToUsd  Float?
  // DOMICILIO | PICKUP | ONLINE
  modality    String @default("DOMICILIO")
  petTypes    String @default("PERRO,GATO") // separado por coma
  petSizes    String @default("S,M,L")
  // [{"name":"Corte de uñas","usd":3}, ...]
  extrasJson  String @default("[]")
  active      Boolean @default(true)

  bookings Booking[]
}

// ────────────────────────────── Mascotas ──────────────────────────────

model Pet {
  id      String @id @default(cuid())
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])
  name    String
  // PERRO | GATO | OTRO
  species String
  breed   String?
  // S | M | L
  size    String
  notes   String?
  // Campos opcionales del perfil ampliado de la mascota
  birthDate   DateTime?
  weightKg    Float?
  // MACHO | HEMBRA | N/D
  gender      String?

  bookings Booking[]
}

// ────────────────────────────── Reservas ──────────────────────────────

model Booking {
  id         String @id @default(cuid())
  code       String @unique
  clientId   String
  client     User   @relation("ClientBookings", fields: [clientId], references: [id])
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id])
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id])
  petId      String
  pet        Pet      @relation(fields: [petId], references: [id])

  address      String
  scheduledAt  DateTime
  // PENDIENTE_PAGO | CONFIRMADA | EN_CURSO | COMPLETADA | CANCELADA
  status       String @default("PENDIENTE_PAGO")
  priceUsd     Float
  priceBs      Float
  commissionUsd Float
  extrasJson   String @default("[]")
  notes        String?
  evidenceNote String?

  createdAt DateTime @default(now())

  payment Payment?
  review  Review?
}

// ────────────────────────────── Pagos ──────────────────────────────

model Payment {
  id        String @id @default(cuid())
  bookingId String @unique
  booking   Booking @relation(fields: [bookingId], references: [id])
  // PAGO_MOVIL | TRANSFERENCIA | ZELLE | BINANCE | EFECTIVO
  method    String
  amountUsd Float
  amountBs  Float
  // referencia (Pago Móvil / transferencia) | comprobante (Zelle) | TXID (Binance)
  reference String?
  // PENDIENTE | VERIFICADO | RECHAZADO
  status    String  @default("PENDIENTE")
  reconciledBy String?
  createdAt DateTime @default(now())
}

// ────────────────────────────── Reseñas ──────────────────────────────

model Review {
  id         String @id @default(cuid())
  bookingId  String? @unique
  booking    Booking? @relation(fields: [bookingId], references: [id])
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id])
  authorName String
  rating     Int // 1..5
  comment    String
  // PUNTUALIDAD,TRATO,PRECIO,LIMPIEZA (separado por coma)
  tags       String  @default("")
  response   String? // respuesta del prestador
  hidden     Boolean @default(false)
  createdAt  DateTime @default(now())
}

// ─────────────────────── Notificaciones (WhatsApp simulado + in-app) ───────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  channel   String   @default("WHATSAPP") // WHATSAPP | INAPP
  template  String // CONFIRMACION_RESERVA, PAGO_VERIFICADO, RECORDATORIO_24H, ESTADO_PEDIDO...
  body      String
  // ENVIADO | ENTREGADO | LEIDO | PROGRAMADO
  status    String   @default("ENVIADO")
  createdAt DateTime @default(now())
  readAt    DateTime?
}

// ────────────────────────────── Configuración ──────────────────────────────

model Settings {
  id               String    @id @default("main")
  usdToBs          Float     @default(40)
  commissionPct    Float     @default(15)
  defaultRadiusKm  Float     @default(8)
  usdToBsSource    String    @default("manual")
  usdToBsUpdatedAt DateTime?
  autoRate         Boolean   @default(true)
  gmapsApiKey      String?
}

// ─────────────────────── Recuperación de contraseña ───────────────────────

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  // SHA-256 del token (el token crudo SOLO viaja en el link; nunca en la DB)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// ─────────────────────── Geografía: ciudades y sectores ───────────────────────

model City {
  id     String  @id @default(cuid())
  name   String
  state  String // entidad federal (ej: Bolívar)
  lat    Float
  lng    Float
  active Boolean @default(true)

  @@unique([name, state])
}

// cityName es denormalizado: guarda el MISMO valor exacto de Provider.city
model Sector {
  id       String  @id @default(cuid())
  cityName String
  name     String
  // CENTRO | NORTE | SUR | ESTE | OESTE
  zone     String  @default("CENTRO")
  lat      Float?
  lng      Float?
  active   Boolean @default(true)

  @@unique([cityName, name])
}

// ─────────────────────── CRM del prestador ───────────────────────

model CrmContact {
  id         String    @id @default(cuid())
  providerId String
  // Cliente registrado de la plataforma (null si es contacto manual sin cuenta)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id])
  name       String
  phone      String?
  email      String?
  petName    String?
  petType    String?
  // NUEVO | ACTIVO | VIP | INACTIVO
  status     String    @default("NUEVO")
  // MANUAL | RESERVA
  source     String    @default("MANUAL")
  notes      String?
  totalVisits    Int     @default(0)
  totalSpentUsd  Float   @default(0)
  lastVisitAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now())

  @@index([providerId, userId])
}

// ─────────────────────── Agenda del prestador ───────────────────────

model CalendarEvent {
  id          String   @id @default(cuid())
  providerId  String
  title       String
  // Fecha "YYYY-MM-DD" (naive, sin zona horaria — estilo del proyecto)
  date        String
  startTime   String? // "HH:MM"
  durationMin Int?
  // MANUAL | RESERVA | RECORDATORIO
  type        String   @default("MANUAL")
  // PENDIENTE | CONFIRMADO | COMPLETADO | CANCELADO
  status      String   @default("PENDIENTE")
  contactId   String? // enlace opcional con CrmContact
  clientName  String?
  phone       String?
  petName     String?
  address     String?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([providerId, date])
}

// ─────────────────────── Firulais 🐕 (asistente FAQ) ───────────────────────

// Entradas de conocimiento del asistente (FAQ). keywords separadas por coma,
// en minúsculas y sin acentos (el matching normaliza igual).
model FirulaisEntry {
  id        String   @id @default(cuid())
  question  String
  answer    String
  keywords  String   @default("")
  active    Boolean  @default(true)
  hits      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

// Log de preguntas NO respondidas por la base de conocimiento (para entrenar)
model FirulaisLog {
  id        String   @id @default(cuid())
  question  String
  matched   Boolean  @default(false)
  entryId   String?
  createdAt DateTime @default(now())
}
